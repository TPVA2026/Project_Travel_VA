{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CandidatePlan",
  "description": "Candidate itinerary proposed by the LLM (M3). Always UNVERIFIED until M4 evaluates it. Unknown cost/time/distance = null (never 0).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "planId",
    "title",
    "destinationId",
    "days",
    "missingData",
    "assumptions"
  ],
  "properties": {
    "planId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "destinationId": {
      "type": "string"
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dayNumber",
          "date",
          "activities",
          "travelLegs"
        ],
        "properties": {
          "dayNumber": {
            "type": "integer",
            "minimum": 1
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "activities": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "activityId",
                "placeId",
                "type",
                "startTime",
                "endTime",
                "estimatedCostVnd",
                "costStatus",
                "reason"
              ],
              "properties": {
                "activityId": {
                  "type": "string"
                },
                "placeId": {
                  "type": "string",
                  "description": "Must be an id from the supplied dataset"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "sightseeing",
                    "dining"
                  ]
                },
                "startTime": {
                  "type": "string",
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                },
                "endTime": {
                  "type": "string",
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                },
                "estimatedCostVnd": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "description": "null = unknown; never 0 for unknown"
                },
                "costStatus": {
                  "type": "string",
                  "enum": [
                    "KNOWN",
                    "UNVERIFIED",
                    "NO_DATA"
                  ]
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          },
          "travelLegs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fromPlaceId",
                "toPlaceId",
                "durationMin",
                "distanceKm"
              ],
              "properties": {
                "fromPlaceId": {
                  "type": "string"
                },
                "toPlaceId": {
                  "type": "string"
                },
                "durationMin": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "distanceKm": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "missingData": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
