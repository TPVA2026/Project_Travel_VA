# Copy to backend/.env (never commit .env). Keys live ONLY on the server.
# Explicit provider selection; unset AI_PROVIDER keeps the legacy Gemini path.
AI_PROVIDER=freemodel
FREEMODEL_BASE_URL=https://freemodel.in/v1
FREEMODEL_API_KEY=
FREEMODEL_MODEL=gemini-3.7-flash
FREEMODEL_TIMEOUT_MS=180000
# At most one retry, only for transient HTTP responses (never timeout/invalid output).
FREEMODEL_MAX_RETRIES=1
# Used only with AI_PROVIDER=gemini:
GEMINI_API_KEY=
OPENTRIPMAP_API_KEY=
# OSRM enrichment is opt-in. No public provider is a production default.
OSRM_ROUTING_ENABLED=false
OSRM_BASE_URL=
# Comma-separated reviewed MVP place IDs. Both leg endpoints must be listed.
OSRM_MVP_PLACE_IDS=
# Enable only profiles verified on the configured OSRM deployment.
OSRM_ENABLED_PROFILES=driving
OSRM_TIMEOUT_SECONDS=3
OSRM_MAX_SNAP_DISTANCE_METERS=100
OSRM_CACHE_SIZE=256
# Example for a self-hosted OSRM container/network (keep disabled until FIX-10
# supplies reviewed driving points for every listed endpoint):
# OSRM_ROUTING_ENABLED=true
# OSRM_BASE_URL=http://osrm:5000
# OSRM_MVP_PLACE_IDS=REST_H_05,ATTR_H_03,ATTR_H_08,ATTR_H_01,ATTR_H_05,REST_H_10
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=3
PORT=3001
ALLOWED_ORIGIN=http://localhost:5173
